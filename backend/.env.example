# Copy to .env and change the values. Never commit a real .env.
# Admin token for POST /api/admin/* (header: X-Admin-Token)
OPENLIVE_ADMIN_TOKEN=change-me-to-a-long-random-token
# Demo activation code seeded on first run (reusable, for testing only)
OPENLIVE_SEED_CODE=OPENLIVE-DEMO-2026
# SQLite file (default: openlive.db next to app.py)
OPENLIVE_DB=openlive.db
# Port (default 8000)
PORT=8000
